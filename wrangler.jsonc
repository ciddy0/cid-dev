{
  "name": "cid-dev",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "ACCOUNT_ID": "1633cee34f84cbf21600ae9b7fd7f819",
    "LAKE_BUCKET": "cid-dev-lake"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE",
        "class_name": "LiveHub"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "cid-dev-metro"
    },
    {
      "bucket_name": "cid-dev-metro",
      "binding": "cid_dev_metro",
      "remote": true
    }
  ],
  "pipelines": [
    { "binding": "LAKE", "stream": "04ba059968654b17a23a725a22eba33c" },
    { "binding": "TIMETABLES", "stream": "36e8b8fa919c449e830297405fbb9173" }
  ],
  "triggers": {
    "crons": ["0 10 * * *", "0 12 * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveHub"]
    }
  ],
  "routes": [
    {
      "pattern": "cid.dev",
      "custom_domain": true
    }
  ]
}
